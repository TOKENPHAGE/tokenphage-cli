{
  "name": "tokenphage",
  "version": "2026.9.1",
  "description": "AI 토큰 사용량 GitHub README 뱃지",
  "author": "kobenlys <kobenlys@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TOKENPHAGE/tokenphage-cli.git"
  },
  "main": "src/index.js",
  "bin": {
    "tokenphage": "./src/index.js"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "cross-env TOKENPHAGE_API=http://localhost:8080 node src/index.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='src/index.js' --test-coverage-exclude='src/ui.js' --test-coverage-exclude='src/animated-select.js' --test-coverage-exclude='src/gradient.js' --test-coverage-exclude='src/auth.js' --test-coverage-exclude='src/scheduler.js' --test-coverage-exclude='src/parser.js' --test-coverage-lines=80 --test-coverage-functions=80 test/*.test.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "glob": "^13.0.6",
    "gradient-string": "^3.0.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "overrides": {
    "mute-stream": "^3.0.0"
  },
  "engines": {
    "node": "^22.14.0 || >=23.6.0"
  }
}
